<?xml version="1.0" encoding="utf-8"?>
<!-- Scrollable so the routing options remain reachable on short screens. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="24dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp">

    <!-- Shown while converting. -->
    <LinearLayout
        android:id="@+id/spinner_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/splash_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splash_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Shown first instead, when Valhalla is the routing engine: the surface preference
         has to be picked before routing, since it changes the route. -->
    <LinearLayout
        android:id="@+id/surface_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/surface_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/surface_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/surface_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="4dp"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/surface_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/surface_go"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/convert" />

        <Button
            android:id="@+id/surface_open_original"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/view_track"
            android:visibility="gone" />

        <Button
            android:id="@+id/surface_go_open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/convert_and_open" />

        <Button
            android:id="@+id/surface_send_original"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/send_original_to"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Which backend is about to route, and how it is configured. Outside both groups so
         it shows on the surface prompt and while converting. -->
    <TextView
        android:id="@+id/splash_backend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <!-- Outside both groups, so it is visible whichever face the splash is showing.
         Sets the expectation up front rather than letting the user discover it by
         comparing the track against Maps afterwards. -->
    <TextView
        android:id="@+id/splash_disclaimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:drawableStart="@drawable/ic_warning"
        android:drawableLeft="@drawable/ic_warning"
        android:drawablePadding="10dp"
        android:gravity="start|center_vertical"
        android:text="@string/splash_disclaimer"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />

    <!-- Escape hatch: swap to the full UI, which is where the settings live. Visible on
         both faces of the splash. -->
    <Button
        android:id="@+id/splash_settings"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
            android:text="@string/settings" />

    </LinearLayout>

</ScrollView>
