<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Converting a link is the first thing this app does, so it is the first thing on its
         home screen. The conversion itself still belongs to MainActivity, which owns the
         progress log, the summary and every share target - this only hands the text over. -->
    <EditText
        android:id="@+id/link_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_link"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:maxLines="3" />

    <Button
        android:id="@+id/convert_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:text="@string/convert" />

    <!-- The other way to start a conversion: an existing GPX rather than a link. Alongside the
         link field because they are the same kind of act, and both hand off to MainActivity. -->
    <Button
        android:id="@+id/reroute_gpx_button"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reroute_gpx" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="?android:attr/listDivider" />

    <!-- Which folder is being listed. The screen only ever shows the one the user granted, so
         naming it is the difference between "nothing saved" and "looking in the wrong place". -->
    <TextView
        android:id="@+id/saved_folder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:paddingBottom="4dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:singleLine="true"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <!-- Tapping a row is not self-evident when the row also carries a button, so it is spelled
         out once. Hidden along with the list when there is nothing to tap. -->
    <TextView
        android:id="@+id/saved_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/saved_hint"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/saved_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible" />

    <!-- Carries the empty case and any listing error, so there is never a blank screen with no
         explanation. -->
    <TextView
        android:id="@+id/saved_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="24dp"
        android:gravity="center_horizontal"
        android:lineSpacingExtra="3dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textSize="14sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/saved_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- A fixed footer rather than the end of the list: settings must stay reachable however
         far down the routes someone has scrolled. -->
    <Button
        android:id="@+id/settings_button"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings" />

</LinearLayout>
