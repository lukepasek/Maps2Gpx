<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <pl.net.xtech.maps2gpx.TrackMapView
        android:id="@+id/detail_track_outline"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/detail_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <ImageButton
            android:id="@+id/detail_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:tint="#FFFFFFFF" />

        <TextView
            android:id="@+id/detail_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/detail_delete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete"
            android:padding="12dp"
            android:src="@drawable/ic_delete"
            android:tint="#FFFFFFFF" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/detail_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:indeterminate="true" />

    <LinearLayout
        android:id="@+id/detail_bottom_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/detail_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/detail_center_location"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/floating_action_background"
                android:contentDescription="@string/center_current_location"
                android:elevation="10dp"
                android:padding="13dp"
                android:src="@drawable/ic_my_location"
                android:tint="#FFFFFFFF"
                android:translationZ="2dp" />

            <ImageButton
                android:id="@+id/detail_open"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/floating_action_background"
                android:contentDescription="@string/open"
                android:elevation="10dp"
                android:padding="13dp"
                android:src="@drawable/ic_open_external"
                android:tint="#FFFFFFFF"
                android:translationZ="2dp" />

            <ImageButton
                android:id="@+id/detail_share"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/floating_action_background"
                android:contentDescription="@string/share"
                android:elevation="10dp"
                android:padding="13dp"
                android:src="@drawable/ic_share"
                android:tint="#FFFFFFFF"
                android:translationZ="2dp" />

            <ImageButton
                android:id="@+id/detail_reroute"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/floating_action_background"
                android:contentDescription="@string/reroute"
                android:elevation="10dp"
                android:padding="13dp"
                android:src="@drawable/ic_reroute"
                android:tint="#FFFFFFFF"
                android:translationZ="2dp" />

            <ImageButton
                android:id="@+id/detail_reverse"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/floating_action_background"
                android:contentDescription="@string/reverse_and_save"
                android:elevation="10dp"
                android:padding="13dp"
                android:src="@drawable/ic_reverse"
                android:tint="#FFFFFFFF"
                android:translationZ="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/detail_profile_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/profile_overlay_background"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="9dp"
            android:paddingRight="12dp"
            android:paddingBottom="2dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/detail_profile_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="#FFC8C8C8"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/detail_info"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/gpx_information"
                    android:padding="7dp"
                    android:src="@drawable/ic_info"
                    android:tint="#FFC8C8C8" />
            </LinearLayout>

            <TextView
                android:id="@+id/detail_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detail_surface_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="#FFE0E0E0"
                android:textSize="12sp" />

            <pl.net.xtech.maps2gpx.ElevationProfileView
                android:id="@+id/detail_elevation_profile"
                android:layout_width="match_parent"
                android:layout_height="118dp"
                android:layout_marginTop="0dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/detail_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC000000"
        android:padding="16dp"
        android:textColor="#FFFFB74D"
        android:visibility="gone" />
</FrameLayout>