<?xml version="1.0" encoding="utf-8"?>
<!-- Scrollable, because this screen grew past one phone screen: with the folder, engine and
     post-action sections plus the paste field and the log, the Convert button was being clipped
     off the bottom entirely on a 6.1" device. The log below keeps its own fixed-height scroller
     rather than a weight, so it cannot collapse to nothing inside this one. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Configuration. This is what you see when the app is opened from the launcher
         with nothing to convert. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_folder"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/folder_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="@string/folder_none" />

        <Button
            android:id="@+id/folder_button"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/change" />
    </LinearLayout>


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/settings_engine"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/engine_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/engine_osrm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/engine_osrm" />

        <RadioButton
            android:id="@+id/engine_valhalla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/engine_valhalla" />

        <RadioButton
            android:id="@+id/engine_brouter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/engine_brouter" />
    </RadioGroup>

    <TextView
        android:id="@+id/engine_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="32dp"
        android:paddingStart="32dp"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/settings_after"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/action_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/action_share"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_share" />

        <RadioButton
            android:id="@+id/action_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_view" />

        <RadioButton
            android:id="@+id/action_direct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_direct" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingLeft="32dp">

        <TextView
            android:id="@+id/direct_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="@string/direct_none" />

        <Button
            android:id="@+id/direct_button"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/change" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/auto_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/auto_open" />

    <CheckBox
        android:id="@+id/auto_close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auto_close" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="12dp"
        android:background="?android:attr/listDivider" />

    <!-- Act on whatever this screen last converted. Disabled until there is a result, which
         after a share is the route that arrived through the splash. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/share_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/share" />

        <Button
            android:id="@+id/open_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/open" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible" />

    <ScrollView
        android:id="@+id/log_scroll"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/log_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </ScrollView>

</LinearLayout>

</ScrollView>
