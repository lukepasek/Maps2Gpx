<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Warning text on the route summary. Per-theme rather than one hex value, because a
        warning has to be legible against both backgrounds and no single amber manages that:
        a shade with enough contrast on white is dim on near-black, and vice versa. The dark
        counterpart lives in res/values-night/colors.xml, swapped by the same system setting
        that swaps the theme.
    -->
    <color name="warning">#E65100</color>

</resources>
